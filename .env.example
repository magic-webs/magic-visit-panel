# Same InstantDB app id used by the mobile app as EXPO_PUBLIC_INSTANT_APP_ID
# and by the auth-bridge Worker as INSTANT_APP_ID. Not a secret — used by the
# browser InstantDB client for realtime reads and the login token exchange.
NEXT_PUBLIC_INSTANT_APP_ID=

# auth-bridge Worker base URL, server-side only. Every mutation goes through
# this panel's own app/api/** Route Handlers, which forward to this URL with
# a server-held bearer token — the browser never talks to the bridge
# directly. Local dev against `wrangler dev`: http://localhost:8787
AUTH_BRIDGE_URL=http://localhost:8787

# This project's expo.dev account/org slug — not discoverable from app.json
# alone. Leave blank to leave the "View builds on EAS" link disabled; set it
# to enable a direct link to this project's EAS builds page.
NEXT_PUBLIC_EXPO_ACCOUNT=
# Matches app.config.js's "slug" — only change this if the mobile app's slug changes.
NEXT_PUBLIC_EXPO_PROJECT_SLUG=urmil-jewellers-ramnagar

# --- Automated APK builds (branding page "Create APK" button) ---
# Server-only — never exposed to the browser. magic-webs/magic-visit-app is
# PRIVATE, so this needs a GitHub PAT (fine-grained, scoped to that repo,
# with "Actions: read and write" permission — or a classic token with the
# full `repo` scope, not just `public_repo`) that lets this panel dispatch
# its .github/workflows/eas-build.yml. That workflow itself needs its OWN
# secrets configured on the GitHub repo (INSTANT_APP_ID, AUTH_BRIDGE_URL —
# a real deployed URL, not localhost — and EXPO_TOKEN) before a dispatched
# build can actually succeed. Leave GITHUB_TOKEN unset to disable automated
# builds — the button then just reports that plainly, and "View builds on
# EAS" (above) still works.
GITHUB_TOKEN=
MOBILE_REPO_OWNER=magic-webs
MOBILE_REPO_NAME=magic-visit-app
MOBILE_REPO_REF=main

# --- Custom domains (Export page "Custom domain" card) ---
# Server-only. Lets tenants attach their own domain to their Cloudflare
# Pages project (named after their slug — the same project web-deploy.yml
# deploys to) with Vercel-style DNS instructions and live status, no
# Cloudflare dashboard visit needed. CLOUDFLARE_API_TOKEN needs "Cloudflare
# Pages: Edit" permission on the account CLOUDFLARE_ACCOUNT_ID identifies —
# the same account already used for `wrangler pages deploy`. Leave both
# unset to disable the feature — the card then just explains what's missing.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
